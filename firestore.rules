rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // 관리자: admins 컬렉션에 본인 uid 문서가 있는 계정만
    function isAdmin() {
      return request.auth != null
        && exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }
    function signedIn() { return request.auth != null; }
    function isMe(uid) { return signedIn() && request.auth.uid == uid; }

    // 상품·쇼핑 설정: 누구나 보기, 관리자만 수정
    match /products/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }
    match /shop/{doc} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // 고객 회원 정보: 본인만 보고 고치기, 관리자는 보기
    match /users/{uid} {
      allow read: if isMe(uid) || isAdmin();
      allow create: if isMe(uid)
        && request.resource.data.keys().hasOnly(['username','name','tel','email','zip','addr1','addr2','marketing','provider','agreedAt','createdAt'])
        && request.resource.data.name is string && request.resource.data.name.size() <= 40;
      allow update: if isMe(uid)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['name','tel','zip','addr1','addr2','marketing'])
        && request.resource.data.name is string && request.resource.data.name.size() <= 40;
      allow delete: if isMe(uid);
    }

    // 아이디 → 로그인 연결: 아이디 하나씩만 확인 가능(목록 보기 불가), 처음 가입한 사람만 차지
    match /usernames/{id} {
      allow get: if true;
      allow list: if false;
      allow create: if signedIn()
        && id.matches('^[a-z][a-z0-9_]{3,15}$')
        && request.resource.data.keys().hasOnly(['uid','email'])
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.email == request.auth.token.email;
      allow update: if false;
      allow delete: if signedIn() && resource.data.uid == request.auth.uid;
    }

    // 아이디 찾기: 이름+휴대폰 / 이름+이메일을 되돌릴 수 없게 바꾼 값으로만 조회, 가려진 아이디만 저장
    match /findid/{key} {
      allow get: if true;
      allow list: if false;
      allow create, update: if signedIn()
        && request.resource.data.keys().hasOnly(['uid','id','at'])
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.id is string && request.resource.data.id.size() <= 16;
      allow delete: if signedIn() && resource.data.uid == request.auth.uid;
    }

    // 주문: 회원·비회원 모두 접수 가능, 회원은 본인 주문만 보기, 상태 변경은 관리자만
    match /orders/{id} {
      allow create: if (request.resource.data.uid == null || isMe(request.resource.data.uid))
        && request.resource.data.id == id
        && request.resource.data.status in ['주문서 접수', '결제 대기']
        && request.resource.data.total is number
        && request.resource.data.items is list && request.resource.data.items.size() <= 60;
      allow read: if isAdmin() || (signedIn() && resource.data.uid == request.auth.uid);
      allow update, delete: if isAdmin();
    }

    // 관리자 로그인 아이디: 아이디 하나씩만 확인 가능, 관리자 본인만 만들고 지우기
    match /adminLogins/{id} {
      allow get: if true;
      allow list: if isAdmin() && resource.data.uid == request.auth.uid;
      allow create: if isAdmin()
        && id.matches('^[a-z][a-z0-9_]{3,15}$')
        && request.resource.data.keys().hasOnly(['uid','email'])
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.email == request.auth.token.email;
      allow update: if false;
      allow delete: if isAdmin() && resource.data.uid == request.auth.uid;
    }

    // 관리자 명단: 본인 것만 확인, 수정은 콘솔에서만
    match /admins/{uid} {
      allow read: if request.auth != null && request.auth.uid == uid;
      allow write: if false;
    }
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
